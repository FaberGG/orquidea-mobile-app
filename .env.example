# Copia este archivo como .env.local (no versionado) y ajusta los valores.
# Solo las variables con prefijo EXPO_PUBLIC_ se exponen a la app y quedan
# visibles en el binario compilado: NUNCA coloques secretos aquí.

# URL base de la API REST (sin barra final).
# Las rutas del contrato ya incluyen /api (ver docs/api/openapi.json), por eso no se agrega aquí.
# En emulador Android, "localhost" de tu PC es 10.0.2.2; en dispositivo físico usa la IP de tu PC.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Entorno lógico de la app: development | staging | production
EXPO_PUBLIC_APP_ENV=development
